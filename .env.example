# VeriDocs Environment Configuration Example
# Copy to .env and configure appropriately before launching.

# SEC EDGAR Polite Client Configuration
# The SEC requires a declared User-Agent with product name and valid contact email.
SEC_USER_AGENT=VeriDocsResearchBot/1.0 (researcher@example.com)
SEC_REQUEST_RATE_LIMIT=2.0
SEC_TIMEOUT_SECONDS=30.0
SEC_MAX_RETRIES=4

# Local Storage Paths
VERIDOCS_DATA_DIR=data
VERIDOCS_CACHE_DIR=data/cache
VERIDOCS_DB_PATH=data/veridocs.db
VERIDOCS_ARTIFACTS_DIR=artifacts

# Local Generator (Ollama)
VERIDOCS_OLLAMA_BASE_URL=http://localhost:11434
VERIDOCS_GENERATOR_MODEL=qwen3:8b
VERIDOCS_GENERATOR_TIMEOUT_SECONDS=60.0

# Retrieval & Embeddings
VERIDOCS_EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
VERIDOCS_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
VERIDOCS_NLI_MODEL_ID=cross-encoder/nli-deberta-v3-small
VERIDOCS_RRF_K0=60

# Server Configuration
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO
